# ---- Core ----
DATABASE_URL=postgres://classbridge:classbridge@127.0.0.1:54329/classbridge
# Public base URL used in emails, Stripe redirects and certificate links
APP_URL=http://localhost:3000
# 32+ random chars; used for HMAC of tokens. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Minutes a booking slot is held during checkout
BOOKING_HOLD_MINUTES=10
# Platform fee in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1500
# Private upload storage directory (never served publicly)
STORAGE_DIR=./storage/private
# Show the developer email outbox at /dev/outbox (NEVER enable in production)
ENABLE_DEV_OUTBOX=false

# ---- Payments: Stripe (test or live keys) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Live classroom: LiveKit (Cloud or self-hosted) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Geocoding ----
# Mapbox (preferred). Set MAPBOX_PERMANENT_GEOCODING=true only if your Mapbox plan permits permanent storage.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT_GEOCODING=false
# Nominatim (OSM) — only enabled when a contact email is set (required by its usage policy, max 1 req/s)
NOMINATIM_CONTACT_EMAIL=
# Map tiles (default: OpenStreetMap standard tiles; use a commercial tile provider for production traffic)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ---- Email: Resend ----
RESEND_API_KEY=
EMAIL_FROM=
